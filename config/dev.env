# dev: the only environment deployed for this project. Names and policies only; no secrets or IDs.
# Endpoints for an environment are written by `infra/up.sh <env>` to .env.<env> (gitignored).
DOCAI_ENV=dev
RG=rg-insurance-docai-dev
LOCATION=eastus
PBI_WORKSPACE=insurance-docai
DATABRICKS_TARGET=free
DATABRICKS_PROFILE=free
SOLUTION_PACKAGE=Unmanaged
PAC_PROFILE=docai-dev
DATA_POLICY=synthetic
REQUIRE_APPROVAL=false
